# ============================================================
# Sagafin — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus dados reais
# ============================================================

# Supabase — Projeto Sagafin
# Encontre em: Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Scripts administrativos avulsos (scripts/*.cjs)
SUPABASE_PROJECT_REF=SEU_PROJECT_ID
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui
SUPABASE_ACCESS_TOKEN=seu_access_token_aqui

# ------------------------------------------------------------
# Variáveis que NÃO ficam neste arquivo (configurar na nuvem):
#
# Vercel > Settings > Environment Variables (funções /api):
#   VITE_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY
#
# GitHub > Settings > Secrets and variables > Actions (Diário Saga):
#   ANTHROPIC_API_KEY, RESEND_API_KEY, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#
# GitHub > Secrets (Agente de Trading — docs/trading-agent.md):
#   TASTY_CLIENT_ID, TASTY_CLIENT_SECRET, TASTY_REFRESH_TOKEN  (my.tastytrade.com > Manage > API Access)
#   opcionais (Playwright): TASTY_USERNAME, TASTY_PASSWORD, TASTY_TOTP_SECRET ou TASTY_STORAGE_STATE
#
# Vercel (botão "Rodar agora" em /admin/trading → api/trading-run.js):
#   GITHUB_TOKEN (fine-grained, Actions: write), GITHUB_REPO, SUPABASE_ANON_KEY, ADMIN_ALLOWED_EMAILS
# ------------------------------------------------------------

# Rodar o agente de trading localmente (nunca commitar valores reais)
TASTY_CLIENT_ID=
TASTY_CLIENT_SECRET=
TASTY_REFRESH_TOKEN=
ANTHROPIC_API_KEY=
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co

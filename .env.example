# ============================================================
# Sagafin — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus dados reais
# ============================================================

# Supabase — Projeto Sagafin
# Encontre em: Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Scripts administrativos avulsos (scripts/*.cjs)
SUPABASE_PROJECT_REF=SEU_PROJECT_ID
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui
SUPABASE_ACCESS_TOKEN=seu_access_token_aqui
